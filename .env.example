# Copy to .env and change the values. Never commit the real .env file.
PORT=3000
DB_FILE=data/expenses.db
# Long random string. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=2h
BCRYPT_ROUNDS=12
CORS_ORIGIN=*
LOGIN_RATE_LIMIT=10
